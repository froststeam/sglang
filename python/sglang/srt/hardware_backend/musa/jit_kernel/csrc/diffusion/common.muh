#pragma once

template <typename T>
struct __align__(16) DiffusionVec8 {
  T elem[8];

  __device__ __forceinline__ static DiffusionVec8 load(const T* ptr) {
    return *reinterpret_cast<const DiffusionVec8*>(ptr);
  }

  __device__ __forceinline__ void store(T* ptr) const {
    *reinterpret_cast<DiffusionVec8*>(ptr) = *this;
  }
};

template <int Threads>
__device__ __forceinline__ float diffusion_block_sum(float value,
                                                     float* warp_sums) {
  const int lane = static_cast<int>(threadIdx.x) & 31;
  const int warp = static_cast<int>(threadIdx.x) >> 5;
  constexpr int kWarps = (Threads + 31) / 32;
#pragma unroll
  for (int offset = 16; offset > 0; offset >>= 1) {
    value += __shfl_down_sync(0xffffffff, value, offset, 32);
  }
  if (lane == 0) {
    warp_sums[warp] = value;
  }
  __syncthreads_lm();

  value = lane < kWarps ? warp_sums[lane] : 0.0f;
  if (warp == 0) {
#pragma unroll
    for (int offset = 16; offset > 0; offset >>= 1) {
      value += __shfl_down_sync(0xffffffff, value, offset, 32);
    }
    if (lane == 0) {
      warp_sums[0] = value;
    }
  }
  __syncthreads_lm();
  const float result = warp_sums[0];
  // The caller may immediately reuse warp_sums for another reduction. Ensure
  // every thread has consumed this result before any warp starts overwriting
  // the shared buffer for the next reduction.
  __syncthreads_lm();
  return result;
}
